# =============================================================================
# Git-Fix Environment Configuration
# =============================================================================
# Copy this file to .env and configure your values
# Run: cp .env.example .env
# =============================================================================

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
# APP_ENV: development | production. When production, a missing
# GITHUB_WEBHOOK_SECRET (or empty SECRET_KEY) will fail fast at boot.
APP_ENV=development
FLASK_DEBUG=true
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
PORT=5000

# =============================================================================
# GITHUB INTEGRATION (Required for webhook functionality)
# =============================================================================
# Get these from: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=your-webhook-secret-min-32-chars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook URL (for local development with ngrok/localtunnel)
# WEBHOOK_URL=https://your-domain.ngrok-free.app/api/v1/webhook

# =============================================================================
# DATABASE (PostgreSQL 15+)
# =============================================================================
POSTGRES_DB=gitfix
POSTGRES_USER=gitfix
POSTGRES_PASSWORD=gitfix_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gitfix:gitfix_dev_password@postgres:5432/gitfix

# For local development without Docker:
# DATABASE_URL=postgresql://gitfix:gitfix_dev_password@localhost:5432/gitfix

# =============================================================================
# REDIS (Caching, Sessions, Rate Limiting, Celery Broker)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD is required by docker-compose (the Redis server starts with
# --requirepass). Pick a strong value and keep it out of any committed file.
REDIS_PASSWORD=redis_dev_password
REDIS_DB=0
REDIS_URL=redis://:redis_dev_password@redis:6379/0

# For local development without Docker:
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# QDRANT VECTOR DATABASE (Semantic Code Search)
# =============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_URL=http://qdrant:6333

# For local development without Docker:
# QDRANT_URL=http://localhost:6333

# =============================================================================
# CELERY (Async Task Processing)
# =============================================================================
CELERY_BROKER_URL=redis://:redis_dev_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_dev_password@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# =============================================================================
# LLM / AI PROVIDERS (Optional - for AI-powered reviews)
# =============================================================================
# LiteLLM Configuration
LITELLM_MASTER_KEY=
LITELLM_PROXY_URL=http://localhost:4000

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Anthropic
ANTHROPIC_API_KEY=

# Google
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# FRONTEND (Vite + React)
# =============================================================================
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
VITE_APP_NAME=Git-Fix
VITE_APP_VERSION=1.0.0

# =============================================================================
# CORS & SECURITY
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# AUTHENTICATION
# =============================================================================
# When AUTH_ENABLED=true, write endpoints require a Bearer token issued by
# /api/v1/auth/login. GITFIX_ADMIN_PASSWORD must be set for login to work.
AUTH_ENABLED=false
GITFIX_ADMIN_USERNAME=admin
GITFIX_ADMIN_PASSWORD=

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_DEFAULT=200 per day, 50 per hour
RATE_LIMIT_WEBHOOK=100 per minute
RATE_LIMIT_API=100 per minute
RATE_LIMIT_AUTH=10 per minute

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/gitfix.log

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=false
GRAFANA_PORT=3000
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_WEBSOCKET=true
FEATURE_AI_REVIEW=true
FEATURE_AUTO_FIX=false
FEATURE_MULTI_TENANT=false
FEATURE_AUDIT_LOG=true

# =============================================================================
# STORAGE & UPLOADS
# =============================================================================
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=/app/uploads
TEMP_FOLDER=/tmp/gitfix

# =============================================================================
# EMAIL (Optional - for notifications)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@gitfix.io
SMTP_TLS=true

# =============================================================================
# SLACK / DISCORD / WEBHOOK NOTIFICATIONS (Optional)
# =============================================================================
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
CUSTOM_WEBHOOK_URL=

# =============================================================================
# BACKUP & RETENTION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=gitfix-backups

# =============================================================================
# DEVELOPMENT OVERRIDES (Only for local development)
# =============================================================================
# Uncomment for local development without Docker:
# DATABASE_URL=postgresql://gitfix:gitfix_dev_password@localhost:5432/gitfix
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# EXAMPLE PRODUCTION VALUES (Reference only - DO NOT USE IN PRODUCTION)
# =============================================================================
# SECRET_KEY=openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=openssl rand -hex 32
# POSTGRES_PASSWORD=openssl rand -hex 16
# JWT_SECRET_KEY=openssl rand -hex 32